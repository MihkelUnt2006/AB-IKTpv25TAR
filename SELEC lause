SELECT tootja, telefonMudel1 AS mudel FROM telefon
Select tootja, telefonMudel1 AS mudel, hind 
from telefon 
ORDER BY hind 
SELECT tootja, telefonMudel1 AS mudel, hind
from telefon
order by hind desc;
SELECT telefonMudel1, hind
from telefon
where hind > 35
order by hind ;
SELECT telefonMudel1, hind
from telefon
where hind BETWEEN 10 and 15
order by hind ;
SELECT telefonMudel1, hind
from telefon 
WHERE hind >=10 and hind <=25
ORDER by hind
Select DIstinct oSystem from telefon;
Select tootja, telefonMudel1
FROM telefon 
WHERE tootja LIKE 'Sony';
Select tootja, telefonMudel1
FROM telefon 
WHERE tootja IN ('Sony', 'Samsung', 'Apple');
Select tootja, telefonMudel1
FROM telefon 
WHERE tootja Like 'Sony' or tootja LIKE 'Samsung' or tootja LIKE 'Apple';
SELECT tootja, telefonMudel1
from telefon 
Where telefonMudel1 Like 'S%';

SELECT AVG(v_aasta) AS 'Keskmine Aasta'
FROM telefon;
SELECT Count (*) AS 'ÜldKogus'
FROM telefon;
SELECT tootja, Count(*) AS 'ÜldKogus'
FROM telefon
