CREATE TABLE praktikajuhendaja (
    praktikajuhendajaID INT PRIMARY KEY identity,
    eesnimi VARCHAR(50) NOT NULL,
    perekonnanimi VARCHAR(50) NOT NULL,
    synniaeg DATE,
    telefon VARCHAR(20)
);
