CREATE VIEW vw_firma_praktikakohad AS
SELECT 
    firma.firmanimi,
    COUNT(praktikabaas.praktikabaasID) AS praktikakohti
FROM praktikabaas
JOIN firma ON firma.firmaID = praktikabaas.firmaID
GROUP BY firma.firmanimi;
