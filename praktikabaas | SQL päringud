SELECT 
    eesnimi,
    perekonnanimi,
    synniaeg,
    dbo.fnComputeAge(CAST(synniaeg AS DATETIME)) AS vanus
FROM praktikajuhendaja;
CREATE FUNCTION fnComputeAge(@DOB DATETIME)
RETURNS INT
AS
BEGIN
    RETURN DATEDIFF(YEAR, @DOB, GETDATE()) 
           - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, @DOB, GETDATE()), @DOB) > GETDATE() THEN 1 ELSE 0 END;
END;
CREATE FUNCTION dbo.CalculateAge(@DOB DATE)
RETURNS INT
AS
BEGIN
    RETURN DATEDIFF(YEAR, @DOB, GETDATE()) 
           - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, @DOB, GETDATE()), @DOB) > GETDATE() THEN 1 ELSE 0 END;
END;
SELECT 
    eesnimi,
    perekonnanimi,
    synniaeg,
    dbo.CalculateAge(synniaeg) AS vanus
FROM praktikajuhendaja;
